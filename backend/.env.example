# ── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Application ─────────────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
ENVIRONMENT=development

# ── Whisper ─────────────────────────────────────────────────────────────────
# Options: tiny | base | small | medium | large
# 'base' is the best balance of speed and accuracy for English.
# Use 'small' or 'medium' for better Hindi/Marathi accuracy.
WHISPER_MODEL=base

# ── Storage ─────────────────────────────────────────────────────────────────
UPLOAD_DIR=app/data/uploads
TEMP_DIR=app/data/temp

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated allowed origins (in development, '*' is used automatically)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
